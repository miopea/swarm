# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Coverage artifacts — regenerate with `uv run pytest --cov`
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/

# Virtual environments
.venv

# User config — generated by `swarm init`, contains local paths
swarm.yaml

# Generated specs
docs/specs/

# Internal audit / post-mortem docs — local working notes, not public docs
docs/audits/
docs/audit/

# Local dev overrides
.env

# Swarm runtime state
.swarm/

# MCP config — machine-specific, generated by `swarm install-hooks`
.mcp.json

# Per-worker hook install output — `swarm install-hooks` copies these into the
# repo's .claude/ from the tracked originals under src/swarm/hooks/commands/
# and src/swarm/hooks/skills/. Edit the originals; these copies are disposable
# and drift silently if committed.
#
# Named individually rather than ignoring .claude/commands/ or .claude/skills/
# wholesale, mirroring the explicit WORKER_COMMAND_FILES / WORKER_SKILL_NAMES
# tuples in hooks/install.py — a hand-authored command or skill added later
# should show up in git status, not vanish. Keep in sync when those lists grow.
.claude/commands/swarm-status.md
.claude/commands/swarm-handoff.md
.claude/commands/swarm-finding.md
.claude/commands/swarm-warning.md
.claude/commands/swarm-blocker.md
.claude/commands/swarm-progress.md
.claude/skills/swarm-checkpoint/
.claude/skills/swarm-coordinate/

# Local UX-audit scratch state — already treated as machine-local by
# coordination/ownership.py and git/conflicts.py
.claude/ux-audit.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# uv
uv.lock

# QA Playwright screenshot runs (mobile, desktop, playbook) — re-generate via
# `uv run python scripts/mobile_qa.py`. Nothing inside a run directory is
# committed: the PNGs are large and reproducible, and the per-run FINDINGS.md
# is a generated manifest indexing those same PNGs, so on its own it would
# point at files that aren't here.
#
# Curated write-ups are PROMOTED OUT of the run directory to
# `docs/qa-<surface>-findings-<date>.md` (e.g. docs/qa-mobile-findings-2026-05-20.md,
# which is tracked). That path sits outside every pattern below, so promotion
# is what makes a finding survive — keep doing it for anything worth keeping.
docs/qa-*/

# Loose one-off QA captures (e.g. docs/qa-share-target.png)
docs/qa-*.png
