# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# User config — generated by `swarm init`, contains local paths
swarm.yaml

# Generated specs
docs/specs/

# Internal audit / post-mortem docs — local working notes, not public docs
docs/audits/
docs/audit/

# Local dev overrides
.env

# Swarm runtime state
.swarm/

# MCP config — machine-specific, generated by `swarm install-hooks`
.mcp.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# uv
uv.lock

# QA Playwright screenshot runs (mobile, desktop, playbook) — re-generate via
# `uv run python scripts/mobile_qa.py`. Nothing inside a run directory is
# committed: the PNGs are large and reproducible, and the per-run FINDINGS.md
# is a generated manifest indexing those same PNGs, so on its own it would
# point at files that aren't here.
#
# Curated write-ups are PROMOTED OUT of the run directory to
# `docs/qa-<surface>-findings-<date>.md` (e.g. docs/qa-mobile-findings-2026-05-20.md,
# which is tracked). That path sits outside every pattern below, so promotion
# is what makes a finding survive — keep doing it for anything worth keeping.
docs/qa-*/

# Loose one-off QA captures (e.g. docs/qa-share-target.png)
docs/qa-*.png
